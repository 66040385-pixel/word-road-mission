          rock.position.set(laneX, 1.2, z);
          rock.rotation.set(Math.random(), Math.random(), Math.random());
          scene.add(rock);
          obstacles.push({ mesh: rock, x: laneX, z: z, radius: 2.2, type: 'rock', hit: false });
        } else if (typeRand < 0.75) {
          const coneGeo = new THREE.ConeGeometry(0.9, 2.4, 8);
          const coneMat = new THREE.MeshLambertMaterial({ color: 0xea580c });
          const cone = new THREE.Mesh(coneGeo, coneMat);
