    function setupInputListeners() {
      window.addEventListener("keydown", e => {
        if (isModalOpen) {
          handleMinigameKeyboard(e);
          return;
        }

        const k = e.key.toLowerCase();
        if (k === "arrowup" || k === "w") keys.up = true;
        if (k === "arrowdown" || k === "s") keys.down = true;
        if (k === "arrowleft" || k === "a") keys.left = true;
        if (k === "arrowright" || k === "d") keys.right = true;
      });

      window.addEventListener("keyup", e => {
        const k = e.key.toLowerCase();
        if (k === "arrowup" || k === "w") keys.up = false;
        if (k === "arrowdown" || k === "s") keys.down = false;
        if (k === "arrowleft" || k === "a") keys.left = false;
        if (k === "arrowright" || k === "d") keys.right = false;
      });

      const bindTouch = (id, action) => {
        const el = document.getElementById(id);
        el.addEventListener("touchstart", (e) => { e.preventDefault(); keys[action] = true; });
        el.addEventListener("touchend", () => keys[action] = false);
      };
      bindTouch("btn-up", "up");
      bindTouch("btn-down", "down");
      bindTouch("btn-left", "left");
      bindTouch("btn-right", "right");
    }

    function updateGamePhysics() {
      if (isModalOpen) return;

      if (carPhysics.spinTimer > 0) {
        carPhysics.spinTimer--;
        carPhysics.angle += 0.28;
        carPhysics.speed *= 0.94;
      } else {
        if (keys.up) {
          carPhysics.speed += carPhysics.accel;
        } else if (keys.down) {
          carPhysics.speed -= carPhysics.accel * 1.5;
        } else {
          if (carPhysics.speed > 0) carPhysics.speed = Math.max(0, carPhysics.speed - carPhysics.friction);
          if (carPhysics.speed < 0) carPhysics.speed = Math.min(0, carPhysics.speed + carPhysics.friction);
        }
        carPhysics.speed = Math.max(-0.5, Math.min(carPhysics.speed, carPhysics.maxSpeed));

        if (carPhysics.speed !== 0) {
          const dir = carPhysics.speed > 0 ? 1 : -1;
          if (keys.left) carPhysics.angle += carPhysics.turnSpeed * dir;
          if (keys.right) carPhysics.angle -= carPhysics.turnSpeed * dir;
        }
      }

      updateEngineSound(carPhysics.speed / carPhysics.maxSpeed);

      const nextX = carPhysics.x - Math.sin(carPhysics.angle) * carPhysics.speed;
      const nextZ = carPhysics.z - Math.cos(carPhysics.angle) * carPhysics.speed;

      carPhysics.x = Math.max(-13, Math.min(13, nextX));

      obstacles.forEach(ob => {
        if (!ob.hit) {
          const dist = Math.hypot(carPhysics.x - ob.x, carPhysics.z - ob.z);
          if (dist < ob.radius + 1.8) {
            ob.hit = true;
            carPhysics.spinTimer = 30;
            carPhysics.speed *= 0.3;
            playCrashSound();

            renderer.domElement.style.filter = "brightness(1.5) contrast(1.2)";
            setTimeout(() => renderer.domElement.style.filter = "none", 120);
          }
        }
      });

      let laserBlocked = false;
      checkpoints.forEach((cp, idx) => {
        if (!cp.passed) {
          if (carPhysics.z > cp.z && nextZ <= cp.z + 1.5) {
            laserBlocked = true;
            carPhysics.speed = 0;
            openCheckpointModal(idx);
          }
        }
      });

      if (!laserBlocked) {
        carPhysics.z = nextZ;
      }

      carGroup.position.set(carPhysics.x, 0, carPhysics.z);
      carGroup.rotation.y = carPhysics.angle;

      const cameraOffset = new THREE.Vector3(0, 5.2, 12.5);
      cameraOffset.applyAxisAngle(new THREE.Vector3(0, 1, 0), carPhysics.angle);
      camera.position.x = carPhysics.x + cameraOffset.x;
      camera.position.y = 5.2;
      camera.position.z = carPhysics.z + cameraOffset.z;

      const lookAhead = new THREE.Vector3(
        carPhysics.x - Math.sin(carPhysics.angle) * 8,
        2.0,
        carPhysics.z - Math.cos(carPhysics.angle) * 8
      );
      camera.lookAt(lookAhead);

      const mph = Math.round(Math.abs(carPhysics.speed) * 52);
      document.getElementById("speed-val").innerText = mph;
      document.getElementById("gear-val").innerText = carPhysics.speed > 0.05 ? 'D' : (carPhysics.speed < -0.05 ? 'R' : 'N');

      renderMinimap();
    }

