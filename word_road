        if (typeRand < 0.4) {
          const rockGeo = new THREE.DodecahedronGeometry(1.6 + Math.random() * 0.8, 1);
          const rockMat = new THREE.MeshLambertMaterial({ color: 0x64748b, flatShading: true });
