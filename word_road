<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Word Road 3D: Roblox Arcade Edition</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700;800;900&family=Chakra+Petch:wght@700;800&display=swap" rel="stylesheet">
  <!-- Three.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    :root {
      --primary: #00a2ff;
      --yellow: #facc15;
      --green: #00b06f;
      --red: #ef4444;
      --surface: #111827;
      --border: rgba(255, 255, 255, 0.18);
    }
    * {
      box-sizing: border-box; margin: 0; padding: 0;
      user-select: none; -webkit-user-select: none;
      touch-action: manipulation;
    }
    html, body {
      width: 100vw; height: 100vh; overflow: hidden;
      background: #7dd3fc; position: fixed; inset: 0;
      font-family: 'Kanit', sans-serif;
    }

    #three-container {
      position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 1;
    }
    #three-container canvas {
      width: 100% !important; height: 100% !important; display: block;
    }

    #top-hud {
      position: fixed; top: 16px; left: 50%; transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.88); backdrop-filter: blur(14px);
      border: 2px solid var(--border);
      border-radius: 20px; padding: 8px 22px;
      display: flex; align-items: center; gap: 18px; color: #fff; z-index: 45;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .hud-chip { display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 700; }
    .hud-icon { width: 18px; height: 18px; fill: #38bdf8; display: inline-block; vertical-align: middle; }
    .hud-pill {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      padding: 3px 12px; border-radius: 999px; font-weight: 800; font-family: 'Chakra Petch', sans-serif;
    }

    #minimap-card {
      position: fixed; top: 16px; right: 16px;
      width: 165px; height: 165px;
      background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(10px);
      border: 3px solid #facc15; border-radius: 18px;
      overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      z-index: 50;
    }
    #minimapCanvas { width: 100%; height: 100%; display: block; }
    .map-tag {
      position: absolute; bottom: 4px; left: 6px;
      font-size: 0.65rem; font-weight: 800; color: #facc15; background: rgba(0,0,0,0.7);
      padding: 2px 6px; border-radius: 4px; pointer-events: none;
    }

    #speedometer-box {
      position: fixed; bottom: 18px; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; z-index: 50;
      pointer-events: none;
    }
    .star-badge {
      background: rgba(15, 23, 42, 0.85); border: 1px solid rgba(255,255,255,0.25);
      border-radius: 8px; padding: 3px 12px; font-size: 0.8rem; font-weight: 800;
      color: #facc15; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;
    }
    .speed-dial {
      background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(10px);
      border: 2px solid rgba(255, 255, 255, 0.2); border-radius: 18px;
      padding: 6px 22px; display: flex; align-items: baseline; gap: 6px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.6);
    }
    .speed-num {
      font-size: 2.3rem; font-weight: 900; color: #ef4444; font-family: 'Chakra Petch', sans-serif;
    }
    .speed-unit { font-size: 0.9rem; font-weight: 800; color: #94a3b8; }
    .gear-mode { font-size: 0.85rem; color: #38bdf8; font-weight: 800; margin-left: 6px; }

    #mobile-controls {
      position: fixed; bottom: 25px; left: 0; right: 0;
      display: flex; justify-content: space-between; padding: 0 35px;
      pointer-events: none; z-index: 60;
    }
    .pad-cluster { pointer-events: auto; display: flex; gap: 14px; align-items: center; }
    .v-btn {
      width: 74px; height: 74px; border-radius: 22px;
      background: rgba(15, 23, 42, 0.8);
      border: 2px solid rgba(255, 255, 255, 0.35); backdrop-filter: blur(8px);
      display: flex; justify-content: center; align-items: center;
      box-shadow: 0 10px 24px rgba(0,0,0,0.5); cursor: pointer;
      transition: transform 0.08s;
    }
    .v-btn:active { transform: scale(0.92); border-color: #facc15; background: rgba(250, 204, 21, 0.35); }
    .v-btn svg { width: 34px; height: 34px; fill: #ffffff; }

    #audio-toggle {
      position: fixed; top: 16px; left: 16px;
      width: 44px; height: 44px; border-radius: 14px;
      background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);
      border: 2px solid rgba(255, 255, 255, 0.2);
      display: flex; justify-content: center; align-items: center;
      cursor: pointer; z-index: 50; color: #fff;
    }
    #audio-toggle svg { width: 22px; height: 22px; fill: #38bdf8; }

    .overlay-screen {
      position: fixed; inset: 0;
      display: flex; justify-content: center; align-items: center; padding: 18px;
      z-index: 100;
    }
    .modal-card {
      background: var(--surface); border: 3px solid #00a2ff; border-radius: 28px;
      padding: 32px 28px; max-width: 500px; width: 100%; text-align: center; color: #fff;
      box-shadow: 0 20px 60px rgba(0,0,0,0.8), 0 0 35px rgba(0, 162, 255, 0.3);
      animation: zoomIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    @keyframes zoomIn { from { transform: scale(0.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }

    .game-h1 {
      font-size: 2.3rem; font-weight: 900;
      background: linear-gradient(135deg, #facc15, #f59e0b);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      margin-bottom: 8px; letter-spacing: 1px;
    }

    .rbx-green-btn {
      width: 100%; padding: 16px; border-radius: 16px; border: none;
      background: linear-gradient(180deg, #00b06f 0%, #008755 100%);
      color: #fff; font-size: 1.25rem; font-weight: 900; cursor: pointer;
      box-shadow: 0 6px 0 #00603d; transition: 0.1s;
      display: flex; justify-content: center; align-items: center; gap: 8px;
    }
    .rbx-green-btn:active { transform: translateY(4px); box-shadow: 0 2px 0 #00603d; }

    /* START SCREEN: โทนสว่างสดใส สไตล์ Arcade ไม่ใช้อิโมจิ */
    #start-screen {
      background: radial-gradient(circle at 50% 40%, rgba(14, 165, 233, 0.45) 0%, rgba(15, 23, 42, 0.92) 80%);
      backdrop-filter: blur(12px);
      z-index: 200;
    }

    .start-modal {
      background: rgba(255, 255, 255, 0.96);
      border: 4px solid #38bdf8;
      border-radius: 32px;
      padding: 30px 24px;
      max-width: 530px;
      width: 92%;
      text-align: center;
      color: #0f172a;
      box-shadow: 0 25px 60px rgba(2, 132, 199, 0.4), 0 0 0 8px rgba(255, 255, 255, 0.3);
      position: relative;
      overflow: hidden;
      animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes popIn {
      from { transform: scale(0.8); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .hero-banner {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      margin: -30px -24px 20px -24px;
      padding: 24px 16px 18px;
      border-bottom: 4px solid #facc15;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }

    .game-logo-title {
      font-size: 2.2rem;
      font-weight: 900;
      color: #ffffff;
      text-transform: uppercase;
      letter-spacing: 1px;
      text-shadow: 3px 3px 0px #0369a1, 0 0 18px rgba(250, 204, 21, 0.6);
      line-height: 1.1;
      font-family: 'Chakra Petch', 'Kanit', sans-serif;
    }

    .game-sub-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 6px;
      background: #facc15;
      color: #713f12;
      font-size: 0.85rem;
      font-weight: 800;
      padding: 4px 14px;
      border-radius: 999px;
      box-shadow: 0 3px 0 #ca8a04;
    }
    .game-sub-badge svg { width: 16px; height: 16px; fill: #713f12; }

    .rule-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 14px;
      text-align: left;
    }

    .rule-card {
      background: #f0f9ff;
      border: 2px solid #bae6fd;
      border-radius: 16px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .rule-card.points {
      background: #fefce8;
      border-color: #fde047;
    }

    .rule-header {
      font-size: 0.9rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .rule-card .rule-header { color: #0284c7; }
    .rule-card .rule-header svg { width: 18px; height: 18px; fill: #0284c7; flex-shrink: 0; }

    .rule-card.points .rule-header { color: #ca8a04; }
    .rule-card.points .rule-header svg { width: 18px; height: 18px; fill: #ca8a04; flex-shrink: 0; }

    .rule-card p {
      font-size: 0.8rem;
      color: #475569;
      line-height: 1.45;
      font-weight: 500;
    }

    .rule-banner-single {
      background: #f8fafc;
      border: 2px dashed #cbd5e1;
      border-radius: 14px;
      padding: 11px 14px;
      font-size: 0.84rem;
      color: #334155;
      margin-bottom: 16px;
      text-align: left;
      display: flex;
      align-items: flex-start;
      gap: 8px;
      line-height: 1.45;
    }
    .rule-banner-single svg { width: 19px; height: 19px; fill: #0284c7; flex-shrink: 0; margin-top: 2px; }

    .start-input {
      width: 100%;
      padding: 14px 18px;
      border-radius: 16px;
      border: 3px solid #cbd5e1;
      background: #f8fafc;
      color: #0f172a;
      font-size: 1.05rem;
      font-weight: 700;
      text-align: center;
      outline: none;
      transition: all 0.2s;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.06);
    }

    .start-input:focus {
      border-color: #0284c7;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.25);
    }

    .start-btn {
      width: 100%;
      margin-top: 14px;
      padding: 15px;
      border-radius: 18px;
      border: none;
      background: linear-gradient(180deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      font-size: 1.25rem;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 6px 0 #047857, 0 10px 18px rgba(16, 185, 129, 0.35);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      transition: transform 0.1s, box-shadow 0.1s;
    }

    .start-btn:active {
      transform: translateY(4px);
      box-shadow: 0 2px 0 #047857;
    }
    .start-btn svg { width: 22px; height: 22px; fill: #ffffff; }

    #checkpoint-modal {
      position: fixed; inset: 0;
      background: rgba(10, 12, 16, 0.88); backdrop-filter: blur(12px);
      display: none; justify-content: center; align-items: center;
      padding: 16px; z-index: 120;
    }
    .cp-box {
      background: #ffffff; border: 4px solid #38bdf8;
      border-radius: 26px; padding: 24px; max-width: 600px; width: 100%;
      color: #1e293b; box-shadow: 0 20px 60px rgba(0,0,0,0.8);
      max-height: 94vh; overflow-y: auto; text-align: left;
    }
    .cp-top {
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;
      border-bottom: 2px dashed #e2e8f0; padding-bottom: 10px;
    }
    .badge-cp {
      background: #fef08a; color: #854d0e; font-weight: 800; font-size: 0.85rem;
      padding: 4px 14px; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px;
      border: 2px solid #facc15;
    }
    .badge-cp svg { width: 16px; height: 16px; fill: #854d0e; }
    .q-statement {
      font-size: 1.18rem; font-weight: 600; margin-bottom: 14px; line-height: 1.5; color: #0f172a;
    }

    .minigame-stage {
      background: #f8fafc; border: 2px solid #cbd5e1; border-radius: 16px;
      padding: 18px; display: flex; flex-direction: column; align-items: center;
      justify-content: center; min-height: 140px; gap: 12px; margin-bottom: 14px;
    }

    .key-badge-btn {
      display: inline-flex; align-items: center; justify-content: center;
      background: #ffffff; border: 3px solid #0284c7; border-radius: 14px;
      padding: 12px 30px; font-family: 'Chakra Petch'; font-weight: 700;
      font-size: 1.5rem; color: #0284c7; box-shadow: 0 5px 0 #bae6fd;
      cursor: pointer; transition: all 0.15s ease;
    }
    .key-badge-btn:hover { background: #f0f9ff; }
    .key-badge-btn:active { transform: translateY(3px); box-shadow: none; }

    .ribbon-bar { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
    .ribbon-btn {
      padding: 10px 16px; border-radius: 10px; border: 2px solid #cbd5e1;
      background: #ffffff; font-family: 'Kanit'; cursor: pointer; font-weight: 500;
      font-size: 0.95rem; color: #1e293b; transition: 0.15s;
    }
    .ribbon-btn:hover { background: #e0f2fe; border-color: #38bdf8; }

    .doc-preview-box {
      width: 220px; height: 85px; background: #ffffff;
      border: 2px solid #cbd5e1; border-radius: 8px; padding: 10px;
      display: flex; flex-direction: column; justify-content: center;
    }

    .table-picker {
      display: grid; grid-template-columns: repeat(4, 38px); grid-template-rows: repeat(3, 38px); gap: 6px;
    }
    .table-cell {
      background: #e2e8f0; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer;
    }
    .table-cell.selected { background: #38bdf8; border-color: #0284c7; }

    #knowledge-modal {
      position: fixed; inset: 0;
      background: rgba(10, 12, 16, 0.92); backdrop-filter: blur(14px);
      display: none; justify-content: center; align-items: center;
      padding: 18px; z-index: 130;
    }
    .knowledge-card {
      background: #0f172a; border: 3px solid #ef4444; border-radius: 28px;
      padding: 26px; max-width: 540px; width: 100%; color: #fff;
      box-shadow: 0 20px 60px rgba(239, 68, 68, 0.3); text-align: left;
      animation: zoomIn 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .kn-header {
      display: flex; align-items: center; gap: 10px; margin-bottom: 12px;
      color: #ef4444; font-size: 1.3rem; font-weight: 800;
    }
    .kn-header svg { width: 28px; height: 28px; fill: #ef4444; }
    .kn-subtitle { font-size: 0.92rem; color: #cbd5e1; margin-bottom: 16px; line-height: 1.5; }
    .kn-box {
      background: #1e293b; border-left: 4px solid #facc15;
      padding: 14px 16px; border-radius: 10px; margin-bottom: 18px;
    }
    .kn-title { font-size: 1.05rem; font-weight: 800; color: #facc15; margin-bottom: 6px; display: flex; align-items: center; gap: 8px; }
    .kn-title svg { width: 20px; height: 20px; fill: #facc15; }
    .kn-desc { font-size: 0.95rem; color: #e2e8f0; line-height: 1.6; }
    .kn-notice {
      font-size: 0.85rem; color: #f87171; background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 8px;
      padding: 8px 12px; margin-bottom: 18px; display: flex; align-items: center; gap: 8px;
    }
    .kn-notice svg { width: 18px; height: 18px; fill: #f87171; flex-shrink: 0; }
  </style>
</head>
<body>

  <div id="three-container"></div>

  <div id="audio-toggle" onclick="toggleAudio()" title="เปิด/ปิดเสียง">
    <svg id="audio-icon" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
  </div>

  <div id="top-hud">
    <div class="hud-chip">
      <svg class="hud-icon" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      <span id="hud-name" style="font-weight:900; color:#38bdf8;">-</span>
    </div>
    <div class="hud-chip">
      <svg class="hud-icon" viewBox="0 0 24 24"><path d="M14.4 6L14 4H5v17h2v-7h5.6l.4 2h7V6z"/></svg>
      <span class="hud-pill" id="hud-stage">ด่าน 1 / 12</span>
    </div>
    <div class="hud-chip">
      <svg class="hud-icon" style="fill:#10b981;" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
      <span class="hud-pill" style="background: linear-gradient(135deg, #10b981, #059669);" id="hud-score">0 / 20</span>
    </div>
  </div>

  <div id="minimap-card">
    <canvas id="minimapCanvas" width="165" height="165"></canvas>
    <div class="map-tag">GPS MAP (1-12)</div>
  </div>

  <div id="speedometer-box">
    <div class="star-badge">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="#facc15"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
      <span>TAXI PRO</span>
    </div>
    <div class="speed-dial">
      <span class="speed-num" id="speed-val">0</span>
      <span class="speed-unit">mph</span>
      <span class="gear-mode" id="gear-val">N</span>
    </div>
  </div>

  <div id="mobile-controls">
    <div class="pad-cluster">
      <div class="v-btn" id="btn-left">
        <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </div>
      <div class="v-btn" id="btn-right">
        <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </div>
    </div>
    <div class="pad-cluster">
      <div class="v-btn" id="btn-down" style="border-color:#ef4444; background: rgba(239, 68, 68, 0.25);">
        <svg viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
      </div>
      <div class="v-btn" id="btn-up" style="border-color:#10b981; background: rgba(16, 185, 129, 0.35); width: 80px; height: 80px;">
        <svg viewBox="0 0 24 24"><path d="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/></svg>
      </div>
    </div>
  </div>

  <!-- START SCREEN: ไร้อิโมจิ 100% ใช้ SVG Vector Icons ทั้งหมด -->
  <div id="start-screen" class="overlay-screen">
    <div class="start-modal">
      
      <div class="hero-banner">
        <div class="game-logo-title">WORD ROAD 3D</div>
        <div class="game-sub-badge">
          <svg viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>
          <span>ภารกิจขับรถซิ่ง พิชิต Microsoft Word ม.1</span>
        </div>
      </div>

      <div class="rule-grid">
