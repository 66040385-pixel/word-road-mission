        stageBox.appendChild(grid);
      }
      else if (m.mode === "choice") {
        const choiceDiv = document.createElement("div");
        choiceDiv.style.display = "flex";
        choiceDiv.style.flexDirection = "column";
        choiceDiv.style.gap = "10px";
        choiceDiv.style.width = "100%";

        m.opts.forEach(opt => {
          const btn = document.createElement("button");
          btn.className = "ribbon-btn";
          btn.style.textAlign = "left";
          btn.style.padding = "12px 18px";
          btn.innerText = opt;
          btn.onclick = () => {
            if (opt.includes(m.target)) submitCorrectTask(stageIdx);
            else submitWrongTask(stageIdx);
          };
          choiceDiv.appendChild(btn);
        });
        stageBox.appendChild(choiceDiv);
      }
    }

    function highlightGrid(cols, rows) {
      document.querySelectorAll(".table-cell").forEach(cell => {
        const c = parseInt(cell.dataset.c);
        const r = parseInt(cell.dataset.r);
        if (c <= cols && r <= rows) cell.classList.add("selected");
        else cell.classList.remove("selected");
      });
    }

    function applyAlignment(type, stageIdx) {
      document.getElementById("sample-text").style.textAlign = type;
      if (type === "center") {
        setTimeout(() => submitCorrectTask(stageIdx), 250);
      } else {
        setTimeout(() => submitWrongTask(stageIdx), 250);
      }
    }

    function handleMinigameKeyboard(e) {
      const m = missions[activeStageIdx];
      if (m.mode !== "shortcut") return;

      const isCtrl = e.ctrlKey || e.metaKey;
      const isTargetCode = e.code === m.codeReq;
      const isTargetKey = e.key.toLowerCase() === m.keyReq;

      if (isCtrl && (isTargetCode || isTargetKey)) {
        e.preventDefault();
        submitCorrectTask(activeStageIdx);
      }
    }

    function submitCorrectTask(stageIdx) {
      const m = missions[stageIdx];

      if (!checkpointFailedAttempts[stageIdx]) {
        score += m.pts;
      }
      playSuccessSound();

      checkpoints[stageIdx].passed = true;
      checkpoints[stageIdx].laser.material.color.setHex(0x10b981);
      checkpoints[stageIdx].laser.material.opacity = 0.15;

      currentStage = stageIdx + 1;
      document.getElementById("hud-stage").innerText = `ด่าน ${Math.min(currentStage + 1, 12)} / 12`;
      document.getElementById("hud-score").innerText = `${Number(score.toFixed(1))} / 20`;
      document.getElementById("checkpoint-modal").style.display = "none";
      isModalOpen = false;

      carPhysics.z -= 4.5;

      if (currentStage >= 12) {
        finishGame();
      }
    }

    function submitWrongTask(stageIdx) {
      checkpointFailedAttempts[stageIdx] = true;
      playWrongSound();
      showKnowledgeSheet(stageIdx);
    }

    function showKnowledgeSheet(stageIdx) {
      const m = missions[stageIdx];
      document.getElementById("checkpoint-modal").style.display = "none";

      document.getElementById("kn-subject").innerText = m.knTitle;
      document.getElementById("kn-text").innerHTML = m.knText;

      document.getElementById("knowledge-modal").style.display = "flex";
    }

    function retryMission() {
      document.getElementById("knowledge-modal").style.display = "none";
      openCheckpointModal(activeStageIdx);
    }

    function renderMinimap() {
      const mCanvas = document.getElementById("minimapCanvas");
      const mCtx = mCanvas.getContext("2d");
      const mw = mCanvas.width;
      const mh = mCanvas.height;

      mCtx.clearRect(0, 0, mw, mh);

      mCtx.fillStyle = "#15803d";
      mCtx.fillRect(0, 0, mw, mh);

      mCtx.fillStyle = "#1e293b";
      mCtx.fillRect(mw / 2 - 20, 0, 40, mh);

      mCtx.strokeStyle = "#facc15";
      mCtx.lineWidth = 2;
      mCtx.setLineDash([4, 4]);
      mCtx.beginPath();
      mCtx.moveTo(mw / 2, 0);
      mCtx.lineTo(mw / 2, mh);
      mCtx.stroke();
      mCtx.setLineDash([]);

      waypoints.forEach((wp, i) => {
        const relZ = wp.z - carPhysics.z;
        const mapY = mh / 2 + (relZ / 400) * (mh / 2);

        if (mapY >= -10 && mapY <= mh + 10) {
          const isPassed = checkpoints[i] ? checkpoints[i].passed : false;
          mCtx.beginPath();
          mCtx.arc(mw / 2, mapY, 8, 0, Math.PI * 2);
          mCtx.fillStyle = isPassed ? "#10b981" : (i === currentStage ? "#facc15" : "#ef4444");
          mCtx.fill();
          mCtx.strokeStyle = "#ffffff";
          mCtx.lineWidth = 1.5;
          mCtx.stroke();

          mCtx.fillStyle = "#000";
          mCtx.font = "bold 9px Kanit";
          mCtx.textAlign = "center";
          mCtx.textBaseline = "middle";
          mCtx.fillText(i + 1, mw / 2, mapY);
        }
      });

      mCtx.save();
      mCtx.translate(mw / 2 + (carPhysics.x / 14) * 16, mh / 2);
      mCtx.rotate(-carPhysics.angle);
      mCtx.beginPath();
      mCtx.moveTo(0, -10);
      mCtx.lineTo(7, 8);
      mCtx.lineTo(0, 4);
      mCtx.lineTo(-7, 8);
      mCtx.closePath();
      mCtx.fillStyle = "#38bdf8";
      mCtx.fill();
      mCtx.strokeStyle = "#ffffff";
      mCtx.lineWidth = 1.5;
      mCtx.stroke();
      mCtx.restore();
    }

    function finishGame() {
      isGameOver = true;
      document.getElementById("finish-screen").style.display = "flex";
      const displayScore = Number(score.toFixed(1));
      document.getElementById("final-score").innerText = `${displayScore} / 20`;

      let rank = "ผู้ขับขี่ฝึกหัด (ควรทบทวนเนื้อหาเพิ่มเติม)";
      if (score >= 17) rank = "ยอดนักขับระดับ Master (ยอดเยี่ยมมาก)";
      else if (score >= 14) rank = "นักขับเชี่ยวชาญ Microsoft Word";
      else if (score >= 10) rank = "ผ่านเกณฑ์การทดสอบ";
      document.getElementById("final-rank").innerText = `ระดับ: ${rank}`;

      const code = `WR3D-${btoa(encodeURIComponent(playerName)).slice(0, 5).toUpperCase()}-${displayScore}PTS-${Date.now().toString().slice(-4)}`;
      document.getElementById("cert-code").innerText = `รหัสยืนยันผลการขับขี่: ${code}`;

      // บันทึกคะแนน
      const FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLScDqf_3sbr3G8XbgR4atsdlcKscqiL_snt7iXLfACcwBjGj1g/formResponse";
      const formData = new FormData();
      formData.append("entry.1063080801", playerName);
      formData.append("entry.557379494", displayScore);
      formData.append("entry.851103684", code);

      fetch(FORM_URL, {
        method: "POST",
        mode: "no-cors",
        body: formData
      }).catch(err => console.error("Error saving score:", err));
    }

    function animate() {
      requestAnimationFrame(animate);
      updateGamePhysics();
      renderer.render(scene, camera);
    }
  </script>
</body>
</html>
